# Application
APP_NAME="Support & Operations Agent"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# Authentication
APPROVAL_API_KEY="dev-approval-secret-key"

# Database (PostgreSQL with pgvector)
# Inside docker compose:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/shop_ops"
# Local testing (SQLite fallback if running outside docker):
# DATABASE_URL="sqlite+aiosqlite:///./test.db"

# LLM Providers (Configure at least one)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# LangSmith Tracing
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="support-operations-agent"
